#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Pre-push runs the SAME gates as Gitea CI (.github/workflows/ci.yml) so a push
# that passes locally passes CI: rustfmt, clippy (-D warnings), and the test
# suite. Coverage's fail-under floor stays CI-only (it needs the instrumented
# llvm-cov build); everything else is enforced here.
#
# We do NOT weaken this gate to get a push through. A slow or flaky test is a
# defect to fix (make it deterministic, or fix the code it caught) — never a
# reason to drop the check. For a faster inner loop scoped to changed crates,
# run ./scripts/check-fast.sh; this hook is the full pre-push guarantee.
echo "==> rustfmt"
cargo fmt --all -- --check

echo "==> clippy (-D warnings, matches CI)"
RUSTFLAGS="-D warnings" cargo clippy --tests --locked --workspace -- -D warnings

echo "==> tests"
cargo test --locked --workspace --all-targets

echo "pre-push checks passed (fmt + clippy + tests; coverage floor runs in Gitea CI)."
