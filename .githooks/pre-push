#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Pre-push is intentionally fmt-only (fast). The heavy gates — clippy (-D warnings),
# the full test suite, and coverage — run on Gitea Actions on every PR
# (.github/workflows/ci.yml: lint-rust / test-rust / coverage-rust), which is the
# source of truth. Running them again locally on every push was slow, redundant,
# and intermittently blocked pushes on flaky tests. For a fuller local pre-flight
# scoped to changed crates, run ./scripts/check-fast.sh.
echo "==> rustfmt"
cargo fmt --all -- --check

echo "pre-push fmt check passed (clippy/tests run in Gitea CI)."
