#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# The gate tests each pushed commit, never the working tree: a branch can be
# pushed without checking it out, and uncommitted files (yours or a concurrent
# session's) can't pass or fail it. Commits are synced into one fixed export
# dir with its own target dir. `rsync -c` rewrites only files whose content
# changed, so mtimes stay truthful and cargo rebuilds only what changed; a raw
# `git archive` stamps every file with the commit date and lets cargo reuse
# artifacts compiled from different source.
ZERO=0000000000000000000000000000000000000000
shas=()
bases=()
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue
  base=""
  if [ "$rsha" != "$ZERO" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    base="$rsha"
  else
    base="$(git merge-base origin/main "$lsha" 2>/dev/null || true)"
  fi
  shas+=("$lsha")
  bases+=("$base")
done
if [ "${#shas[@]}" -eq 0 ]; then
  exit 0
fi

GATE_DIR="$ROOT/target/prepush"
mkdir -p "$GATE_DIR"
LOCK="$GATE_DIR/lock"
until mkdir "$LOCK" 2>/dev/null; do
  echo "==> waiting for another push's gate ($LOCK)"
  sleep 5
done
GATE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/orca-prepush.XXXXXX")"
trap 'rm -rf "$GATE_TMP"; rmdir "$LOCK"' EXIT
export CARGO_TARGET_DIR="$GATE_DIR/target"
# Tests that open the db must never touch the operator's live ~/.orca.
export ORCA_HOME="$GATE_TMP/orca-home"

# Cheap KDF for the local test build (matches CI). Honored only in
# debug/test builds (cfg!(debug_assertions)); release binaries ignore it, so
# production KDF strength is never affected. Skips the memory-hard Argon2 +
# SQLCipher PBKDF2 cost that makes auth tests run tens of seconds each.
export ORCA_TEST_FAST_KDF=1

# Keep the gate HERMETIC: the model-backend integration tests (server crate's
# llm_integration binary) probe a live LM Studio / Ollama and, when one is
# actually running on the dev box, run real inference — each up to the 90s
# CHAT_TIMEOUT (300s under the nextest lmstudio override). That turned the hook
# into a multi-minute "hang" whose outcome depended on whether a local model
# server happened to be up. Point both backends at an unreachable address so
# the 2s availability probe fails fast and every live-model test skips
# gracefully — deterministically, regardless of ambient services. This matches
# CI, where no model server runs and these tests already skip. It removes the
# ambient dependency without weakening any hermetic test.
export LMSTUDIO_URL="http://127.0.0.1:1"
export OLLAMA_URL="http://127.0.0.1:1"

# Hard wall-clock ceiling for the test phase so a genuinely wedged test (or a
# leaked child holding a pipe) can never hang a push indefinitely. Uses GNU
# `timeout` when present (linux CI, macOS with coreutils); degrades to running
# without a ceiling when neither is available. nextest's own per-test
# slow-timeout (.config/nextest.toml) still terminates individual stragglers;
# this is the belt-and-suspenders outer bound.
run_bounded() {
  if command -v timeout >/dev/null 2>&1; then
    timeout "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$@"
  else
    shift # drop the duration arg
    "$@"
  fi
}

if ! command -v cargo-nextest >/dev/null 2>&1; then
  echo "error: cargo-nextest is not installed, but CI runs tests under nextest." >&2
  echo "       install it:  cargo install cargo-nextest --locked" >&2
  exit 1
fi

select_crates() {
  local base="$1" sha="$2" changed meta
  if [ -z "$base" ]; then
    echo "workspace no-base"
    return
  fi
  changed="$(git diff --name-only "$base" "$sha")" || {
    echo "workspace diff-failed"
    return
  }
  if printf '%s\n' "$changed" | grep -qE '^(Cargo\.toml|Cargo\.lock|rust-toolchain(\.toml)?|\.cargo/.*|\.config/nextest\.toml|\.githooks/pre-push)$'; then
    echo "workspace build-config-changed"
    return
  fi
  meta="$(cd "$GATE_DIR/src" && cargo metadata --no-deps --format-version 1 --locked 2>/dev/null)" || {
    echo "workspace metadata-failed"
    return
  }
  printf '%s\n' "$meta" | jq -r --arg root "$GATE_DIR/src/" --arg files "$changed" '
    (.packages | map({name, dir: (.manifest_path | sub("/Cargo.toml$"; "/") | ltrimstr($root)), deps: [.dependencies[] | select(.path != null) | .name]}) | if any(.[]; .dir | startswith("/")) then error("manifest outside gate dir") else . end) as $pkgs
    | ($files | split("\n") | map(select(length > 0))) as $fs
    | [$fs[] as $f | [$pkgs[] | select(.dir as $d | $f | startswith($d))] | max_by(.dir | length) | .name? // empty] | unique as $changed
    | {seen: $changed, frontier: $changed}
    | until(.frontier | length == 0;
        .seen as $s
        | ([$pkgs[] | select(.name as $n | $s | index($n) | not) | select(any(.deps[]; . as $d | $s | index($d)))] | map(.name) | unique) as $new
        | {seen: ($s + $new), frontier: $new})
    | .seen as $all
    | ($all | map(select(. as $n | $changed | index($n) | not))) as $dependents
    | "crates", ($changed | map("changed " + .)[]), ($dependents | map("dependent " + .)[])
  ' || echo "workspace mapping-failed"
}

gate() {
  local selection="$1" scope=() crates=()
  echo "==> rustfmt"
  cargo fmt --all -- --check
  echo "==> test-scope guard"
  ./scripts/check-no-test-scope.sh

  case "$(printf '%s\n' "$selection" | head -1)" in
    workspace*)
      echo "==> crate selection: workspace ($(printf '%s\n' "$selection" | head -1 | cut -d' ' -f2))"
      scope=(--workspace)
      ;;
    *)
      echo "==> crate selection"
      while read -r why name; do
        echo "    $why: $name"
        crates+=("$name")
      done < <(printf '%s\n' "$selection" | tail -n +2)
      if [ "${#crates[@]}" -eq 0 ]; then
        echo "==> crate selection: none affected, skipping clippy and tests"
        return
      fi
      for c in "${crates[@]}"; do scope+=(-p "$c"); done
      ;;
  esac

  echo "==> clippy (-D warnings)"
  RUSTFLAGS="-D warnings" cargo clippy --tests --locked "${scope[@]}" -- -D warnings

  echo "==> tests (nextest)"
  run_bounded 600 cargo nextest run --locked "${scope[@]}" --no-fail-fast
}

gated=" "
for i in "${!shas[@]}"; do
  sha="${shas[$i]}"
  tree="$(git rev-parse "$sha^{tree}")"
  case "$gated" in *" $tree "*) continue ;; esac
  gated="$gated$tree "
  stage="$GATE_TMP/stage"
  rm -rf "$stage"
  mkdir -p "$stage"
  git archive "$sha" | tar -x -C "$stage"
  rsync -rlc --delete "$stage/" "$GATE_DIR/src/"
  echo "==> gating $(git log -1 --format='%h %s' "$sha")"
  (
    selection="$(select_crates "${bases[$i]}" "$sha")"
    cd "$GATE_DIR/src"
    gate "$selection"
  )
done

echo "pre-push checks passed for the selection above; the full workspace and coverage run in Gitea CI."
