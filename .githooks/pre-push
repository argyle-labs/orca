#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "==> rustfmt"
cargo fmt --all -- --check

# clippy --tests compiles the test profile once; cargo test reuses those artifacts.
# Running clippy without --tests would compile a second time under a different profile.
echo "==> clippy"
RUSTFLAGS="-D warnings" cargo clippy --tests -- -D warnings

echo "==> cargo test"
cargo test

echo "==> frontend check"
cd "$ROOT/projects/frontend"
npm run check

echo "==> frontend test"
npm run test:run

echo "==> frontend build"
npm run build

echo "All checks passed."
